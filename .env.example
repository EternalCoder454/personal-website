# Neon Postgres (Vercel > Storage > Neon). Vercel injects this in production.
DATABASE_URL=

# 32+ random chars. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Overrides the placeholder address on the admin account.
ADMIN_EMAIL=

# Stage 2 - social login. Each provider turns on once both values are set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Vercel Blob (Vercel > Storage > Blob). Injected in production.
BLOB_READ_WRITE_TOKEN=

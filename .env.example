# The canonical origin. Set this explicitly: the Vercel variable can
# resolve to a preview domain, which would put the wrong host in every
# canonical link, sitemap entry and share card.
NEXT_PUBLIC_SITE_URL=https://eterneon.net

# Where beta requests go. Two options, Resend wins if both are set.
#
# 1. Resend emails the address to you. The panel already sends through
#    Resend on a verified eterneon.net, so the same key works here and
#    there is no new domain to verify. Reply to the email to answer the
#    person directly: their address is set as reply-to.
RESEND_API_KEY=
# Optional. Must be on a domain verified in Resend.
RESEND_FROM="Eterneon beta <beta@eterneon.net>"
# Optional. Defaults to site.contactEmail.
WAITLIST_TO=
#
# 2. Or post the JSON { email, receivedAt, source } anywhere that takes
#    a POST: a Zapier or Make catch hook, a Slack workflow, a Google
#    Apps Script, or a route on the panel.
#
# With neither set the form logs in development and returns a 503 in
# production telling the visitor to email instead. It fails closed on
# purpose: losing a lead quietly is worse than saying so.
WAITLIST_WEBHOOK_URL=

# The product tour that plays in the overlay. While the video URL is
# empty the page renders the frame with a "being filmed" label and no
# play control, so nothing ships as a button that opens an empty box.
# Set these two and every trigger turns on by itself.
NEXT_PUBLIC_TOUR_VIDEO_URL=
NEXT_PUBLIC_TOUR_POSTER_URL=
# A WebVTT captions file. A tour with no captions excludes people who
# need them and anybody watching without sound.
NEXT_PUBLIC_TOUR_CAPTIONS_URL=

# Server-side performance sampling, and the token that reads it back.
#
# Unset (the default) means the instrumentation is inert and
# /api/perf answers 404. Setting it turns on middleware, which makes
# every page view a function invocation instead of a free CDN hit, so
# turn it on to look at something and turn it off again.
#
#   curl -H "authorization: Bearer $PERF_TOKEN" https://eterneon.net/api/perf
#
# Generate one with: openssl rand -hex 32
PERF_TOKEN=
